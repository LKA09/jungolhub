{
  "manifest_version": 3,
  "name": "JungolHub",
  "description": "Automatically upload accepted JUNGOL solutions to GitHub.",
  "version": "0.3.1",
  "minimum_chrome_version": "111",
  "permissions": ["storage", "scripting"],
  "host_permissions": [
    "https://jungol.co.kr/*",
    "https://*.jungol.co.kr/*",
    "https://api.github.com/*"
  ],
  "action": {
    "default_title": "JungolHub",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "worker.js",
    "type": "module"
  }
}
