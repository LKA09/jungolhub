{
  "manifest_version": 3,
  "name": "JungolHub",
  "description": "Automatically upload accepted JUNGOL solutions to GitHub.",
  "version": "0.1.0",
  "minimum_chrome_version": "111",
  "permissions": ["storage"],
  "host_permissions": [
    "https://jungol.co.kr/*",
    "https://api.github.com/*"
  ],
  "action": {
    "default_title": "JungolHub",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://jungol.co.kr/*"],
      "js": ["page-hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://jungol.co.kr/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
